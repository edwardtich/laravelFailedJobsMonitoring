{
    "name": "edwardtich/laravel-failed-jobs-manager",
    "description": "Failed jobs manager UI for Laravel",
    "type": "library",
    "version": "1.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/queue": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "EdwardTich\\FailedJobsManager\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdwardTich\\FailedJobsManager\\Providers\\FailedJobsManagerProvider"
            ]
        }
    },
    "suggest": {
        "filament/filament": "Required for optional Filament page integration"
    },
    "config": {
        "sort-packages": true
    }
}
